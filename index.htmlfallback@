            <div id="modal-subtitle" class="text-sm md:text-base text-gray-200 leading-relaxed font-medium"></div>
            <button id="modal-continue-btn" onclick="nextQuestion()" class="px-8 py-3.5 bg-gradient-to-r from-yellow-500 to-amber-600 text-black rounded-xl font-bold text-sm md:text-base hover:from-yellow-400 hover:to-amber-500 transition shadow-lg w-full">Next Question</button>
        </div>
    </div>

    <!-- Audio -->
    <script>
        const audioCtx = new(window.AudioContext || window.webkitAudioContext)();

        function playBeep(f = 440, t = 'sine', d = 0.15) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const o = audioCtx.createOscillator(),
                g = audioCtx.createGain();
            o.type = t;
            o.frequency.value = f;
            g.gain.setValueAtTime(0.08, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + d);
            o.connect(g);
            g.connect(audioCtx.destination);
            o.start();
            o.stop(audioCtx.currentTime + d);
        }

        function soundCorrect() { playBeep(523, 'triangle', 0.18);
            setTimeout(() => playBeep(659, 'triangle', 0.18), 150);
            setTimeout(() => playBeep(784, 'triangle', 0.35), 300); }

        function soundWrong() { playBeep(220, 'sawtooth', 0.25);
            setTimeout(() => playBeep(180, 'sawtooth', 0.4), 200); }
    </script>

    <!-- Core App -->
    <script>
        let currentMode = localStorage.getItem('caAuditProMode') || 'study';
        let questionsData = [];
        let currentIdx = 0;
        let isAnswered = false;
        let selectedOption = null;
        // sessionState: array of { selected: null|number, isCorrect: null|boolean, marked: boolean }
        let sessionState = [];
        let toastShown = false;

        function updateModeUI() {
            const s = document.getElementById('btn-mode-study'),
                m = document.getElementById('btn-mode-mcqs');
            const active = "px-5 py-2 rounded-full text-xs md:text-sm font-bold bg-gradient-to-r from-yellow-500 to-amber-600 text-black transition shadow-lg flex items-center gap-2";
            const inactive = "px-5 py-2 rounded-full text-xs md:text-sm font-bold text-gray-400 hover:text-white transition flex items-center gap-2";
            s.className = currentMode === 'study' ? active : inactive;
            m.className = currentMode === 'mcqs' ? active : inactive;
        }

        function switchMode(mode) {
            if (currentMode === mode) return;
            currentMode = mode;
            localStorage.setItem('caAuditProMode', mode);
            updateModeUI();
            resetLifelines();
            loadProgressFromStorage();
            fetchQuestions();
        }

        function saveProgress() {
            const key = `caAuditPro_${currentMode}`;
            const data = { idx: currentIdx, state: sessionState };
            localStorage.setItem(key, JSON.stringify(data));
        }

        function loadProgressFromStorage() {
            const key = `caAuditPro_${currentMode}`;
            const raw = localStorage.getItem(key);
            if (raw) {
                try {
                    const d = JSON.parse(raw);
                    currentIdx = d.idx || 0;
                    sessionState = d.state || [];
                } catch (e) { resetProgress(); }
            } else {
                resetProgress();
            }
        }

        function resetProgress() {
            currentIdx = 0;
            sessionState = [];
            toastShown = false;
        }

        async function fetchQuestions() {
            const url = `./${currentMode}.json`;
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('Network error');
                questionsData = await res.json();
                if (questionsData.length === 0) throw new Error('Empty');
                // Ensure sessionState length matches
                if (sessionState.length !== questionsData.length) {
                    sessionState = questionsData.map((_, i) => sessionState[i] || { selected: null, isCorrect: null,
                        marked: false });
                }
                if (currentIdx >= questionsData.length) currentIdx = 0;
                initGame();
            } catch (e) {
                document.getElementById('question-text').innerText = `Error loading ${url}. Make sure the file exists.`;
            }
        }

        function initGame() {
            document.getElementById('end-screen').classList.add('hidden');
            document.getElementById('quiz-container').classList.remove('hidden');
            document.getElementById('quiz-footer').classList.remove('hidden');
            loadQuestion();
            maybeShowSubscribeToast();
        }

        function loadQuestion() {
            isAnswered = false;
            selectedOption = null;
            const q = questionsData[currentIdx];
            document.getElementById('question-text').innerHTML =
                `<span class="text-yellow-400 font-bold tracking-wider">Q${currentIdx + 1}.</span> ${q.question}`;
            document.getElementById('score-counter').innerText = `Q: ${currentIdx + 1} / ${questionsData.length}`;
            updateMarkReviewIcon();
            const grid = document.getElementById('options-grid');
            grid.innerHTML = '';
            const state = sessionState[currentIdx] || { selected: null, isCorrect: null, marked: false };
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.id = `opt-${idx}`;
                btn.className = "option-btn text-left p-4 md:p-5 text-[14px] md:text-[15px] font-medium rounded-xl flex items-start gap-3 w-full";
                btn.innerHTML =
                    `<span class="text-yellow-400 font-bold shrink-0 mt-0.5">•</span> <span class="leading-relaxed">${opt}</span>`;
                if (state.selected !== null) {
                    btn.disabled = true;
                    if (idx === state.selected && !state.isCorrect) btn.classList.add('option-wrong');
                    if (idx === q.correctOption) btn.classList.add('option-correct');
                    isAnswered = true;
                }
                btn.onclick = () => selectOption(idx);
                grid.appendChild(btn);
            });
            saveProgress();
        }

        function selectOption(idx) {
            if (isAnswered) return;
            playBeep(300, 'sine', 0.08);
            const buttons = document.getElementById('options-grid').children;
            for (let b of buttons) b.classList.remove('option-selected');
            selectedOption = idx;
            document.getElementById(`opt-${idx}`).classList.add('option-selected');
            setTimeout(() => lockAnswer(idx), 500);
        }

        function lockAnswer(idx) {
            if (isAnswered) return;
            isAnswered = true;
            const q = questionsData[currentIdx];
            const isCorrect = idx === q.correctOption;
            sessionState[currentIdx] = { selected: idx, isCorrect, marked: false };
            const selBtn = document.getElementById(`opt-${idx}`);
            const corrBtn = document.getElementById(`opt-${q.correctOption}`);
            selBtn.classList.remove('option-selected');
            if (isCorrect) {
                selBtn.classList.add('option-correct');
                soundCorrect();
            } else {
                selBtn.classList.add('option-wrong');
                if (corrBtn) corrBtn.classList.add('option-correct');
                soundWrong();
            }
            disableAllOptions();
            saveProgress();
            setTimeout(() => showExplanation(isCorrect), 800);
        }

        function disableAllOptions() {
            const btns = document.getElementById('options-grid').children;
            for (let b of btns) b.disabled = true;
        }

        function showExplanation(isCorrect) {
            const q = questionsData[currentIdx];
            const modal = document.getElementById('explanation-modal');
            document.getElementById('modal-title').innerHTML = isCorrect ?
                '<i class="fa-solid fa-circle-check text-green-400 text-3xl"></i> <span class="text-green-400">Awesome!</span>' :
                '<i class="fa-solid fa-circle-xmark text-red-500 text-3xl"></i> <span class="text-red-500">Incorrect!</span>';
            let sub = isCorrect ? 'You selected the right answer.' :
                `Correct answer:<br><div class="text-yellow-400 text-sm md:text-base text-left bg-black/40 p-3 rounded-xl border border-yellow-500/30 mt-2">${q.options[q.correctOption]}</div>`;
            if (q.explanation) sub +=
                `<br><div class="text-gray-300 text-xs md:text-sm text-left bg-black/40 p-3 rounded-xl border border-gray-500/30 mt-2"><b>Explanation:</b> ${q.explanation}</div>`;
            document.getElementById('modal-subtitle').innerHTML = sub;
            document.getElementById('modal-continue-btn').innerText = currentIdx === questionsData.length - 1 ?
                'Finish Quiz' : 'Next Question';
            modal.classList.remove('hidden');
        }

        function nextQuestion() {
            document.getElementById('explanation-modal').classList.add('hidden');
            if (currentIdx < questionsData.length - 1) {
                currentIdx++;
                loadQuestion();
                maybeShowSubscribeToast();
            } else {
                finishQuiz();
            }
        }

        function prevQuestion() {
            document.getElementById('explanation-modal').classList.add('hidden');
            if (currentIdx > 0) {
                currentIdx--;
                loadQuestion();
            }
        }

        function toggleMarkReview() {
            const state = sessionState[currentIdx] || { selected: null, isCorrect: null, marked: false };
            state.marked = !state.marked;
            sessionState[currentIdx] = state;
            updateMarkReviewIcon();
            saveProgress();
        }

        function updateMarkReviewIcon() {
            const btn = document.getElementById('mark-review-btn');
            const state = sessionState[currentIdx] || { marked: false };
            btn.innerHTML = state.marked ?
                '<i class="fa-solid fa-bookmark text-yellow-400"></i>' :
                '<i class="fa-regular fa-bookmark"></i>';
        }

        // Palette
        function togglePalette() {
            const panel = document.getElementById('palette-panel');
            if (panel.classList.contains('hidden')) {
                renderPalette();
                panel.classList.remove('hidden');
            } else {
                panel.classList.add('hidden');
            }
        }

        function renderPalette() {
            const grid = document.getElementById('palette-grid');
            grid.innerHTML = '';
            for (let i = 0; i < questionsData.length; i++) {
                const btn = document.createElement('button');
                btn.textContent = i + 1;
                btn.className = 'palette-btn';
                const state = sessionState[i] || { selected: null, isCorrect: null, marked: false };
                if (i === currentIdx) btn.classList.add('current');
                if (state.marked) btn.classList.add('marked');
                if (state.selected !== null) {
                    btn.classList.add(state.isCorrect ? 'answered' : 'wrong');
                }
                btn.onclick = () => { jumpTo(i);
                    togglePalette(); };
                grid.appendChild(btn);
            }
        }

        function jumpTo(idx) {
            if (idx >= 0 && idx < questionsData.length) {
                currentIdx = idx;
                loadQuestion();
            }
        }

        // Revision
        function openRevision() {
            const panel = document.getElementById('revision-panel');
            const list = document.getElementById('revision-list');
            list.innerHTML = '';
            questionsData.forEach((q, i) => {
                const state = sessionState[i] || { selected: null, isCorrect: null, marked: false };
                const div = document.createElement('div');
                div.className = 'revision-item';
                let statusIcon = '';
                if (state.selected !== null) {
                    statusIcon = state.isCorrect ?
                        '<i class="fa-solid fa-circle-check text-green-400"></i>' :
                        '<i class="fa-solid fa-circle-xmark text-red-500"></i>';
                } else {
                    statusIcon = '<i class="fa-regular fa-circle text-gray-500"></i>';
                }
                div.innerHTML = `
              <div class="flex items-start gap-3">
                <div class="text-lg shrink-0 mt-1">${statusIcon}</div>
                <div class="flex-1">
                  <p class="text-sm font-semibold text-white">Q${i+1}: ${q.question.substring(0,100)}...</p>
                  ${state.selected !== null ? `<p class="text-xs text-gray-400 mt-1">Your answer: <span class="${state.isCorrect ? 'text-green-400' : 'text-red-400'}">${q.options[state.selected]}</span></p>` : ''}
                  <p class="text-xs text-yellow-400 mt-1">Correct: ${q.options[q.correctOption]}</p>
                </div>
              </div>`;
                div.onclick = () => { jumpTo(i);
                    closeRevision(); };
                list.appendChild(div);
            });
            panel.classList.remove('hidden');
        }

        function closeRevision() {
            document.getElementById('revision-panel').classList.add('hidden');
        }

        // Analytics quick display
        function showAnalytics() {
            const total = questionsData.length;
            let attempted = 0,
                correct = 0;
            sessionState.forEach(s => { if (s.selected !== null) { attempted++; if (s.isCorrect) correct++; } });
            const wrong = attempted - correct;
            const score = correct * 3 - wrong * 1;
            alert(
                `📊 Quick Analytics\n\nTotal Questions: ${total}\nAttempted: ${attempted}\nCorrect: ${correct}\nWrong: ${wrong}\nScore: ${score}/${total*3}`
                );
        }

        function finishQuiz() {
            document.getElementById('quiz-container').classList.add('hidden');
            document.getElementById('quiz-footer').classList.add('hidden');
            document.getElementById('end-screen').classList.remove('hidden');
            localStorage.setItem(`caAuditPro_${currentMode}`, JSON.stringify({ idx: 0, state: [] }));
            resetProgress();
        }

        function retakeQuiz() {
            if (confirm('Restart quiz from Question 1?')) {
                resetProgress();
                loadProgressFromStorage();
                resetLifelines();
                initGame();
            }
        }

        function resetLifelines() {
            ['life-5050', 'life-poll', 'life-expert'].forEach(id => {
                const btn = document.getElementById(id);
                btn.disabled = false;
                btn.classList.remove('opacity-40', 'cursor-not-allowed');
            });
        }

        // Lifelines (unchanged logic)
        function use5050() {
            if (isAnswered) return;
            const q = questionsData[currentIdx];
            const wrong = [0, 1, 2, 3].filter(i => i !== q.correctOption);
            wrong.sort(() => Math.random() - 0.5);
            for (let i = 0; i < 2; i++) {
                const el = document.getElementById(`opt-${wrong[i]}`);
                if (el) { el.style.opacity = '0.2';
                    el.disabled = true; }
            }
            document.getElementById('life-5050').disabled = true;
            document.getElementById('life-5050').classList.add('opacity-40', 'cursor-not-allowed');
        }

        function useAudiencePoll() {
            if (isAnswered) return;
            const opt = ['A', 'B', 'C', 'D'][questionsData[currentIdx].correctOption];
            alert(`📊 Audience Poll: Option ${opt} leads with huge majority!`);
            document.getElementById('life-poll').disabled = true;
            document.getElementById('life-poll').classList.add('opacity-40', 'cursor-not-allowed');
        }

        function useExpertAdvice() {
            if (isAnswered) return;
            const opt = ['A', 'B', 'C', 'D'][questionsData[currentIdx].correctOption];
            alert(`👨‍🏫 Satyam's Advice: "Based on standards, Option (${opt}) is the way."`);
            document.getElementById('life-expert').disabled = true;
            document.getElementById('life-expert').classList.add('opacity-40', 'cursor-not-allowed');
        }

        // Subscribe Toast (after 20 attempts)
        function maybeShowSubscribeToast() {
            if (toastShown) return;
            const attempted = sessionState.filter(s => s.selected !== null).length;
            if (attempted >= 20 && !localStorage.getItem('caAuditSubToastShown')) {
                const toast = document.getElementById('toast');
                toast.innerHTML =
                    `❤️ Like the app? <a href="https://youtube.com/@observe_with_satyam?si=9BiGcrs2Dhv4HDFa" target="_blank" class="underline text-yellow-300">Subscribe to Satyam's YouTube</a> for more!`;
                toast.classList.add('show');
                localStorage.setItem('caAuditSubToastShown', '1');
                toastShown = true;
                setTimeout(() => toast.classList.remove('show'), 5000);
                document.getElementById('toast').addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') {
                        // Do nothing, let link open
                    }
                });
            }
        }

        // Swipe
        function setupSwipe() {
            const area = document.getElementById('quiz-container');
            let startX = 0,
                startY = 0;
            area.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
            }, { passive: true });
            area.addEventListener('touchend', (e) => {
                const dx = e.changedTouches[0].clientX - startX;
                const dy = e.changedTouches[0].clientY - startY;
                if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
                    if (dx < 0) nextQuestion();
                    else prevQuestion();
                }
            }, { passive: true });
        }

        // Keyboard shortcuts
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') nextQuestion();
            if (e.key === 'ArrowLeft') prevQuestion();
            if (e.key === 'p' || e.key === 'P') togglePalette();
            if (e.key === 'r' || e.key === 'R') openRevision();
            if (e.key === 'Escape') {
                document.getElementById('explanation-modal').classList.add('hidden');
                document.getElementById('palette-panel').classList.add('hidden');
                document.getElementById('revision-panel').classList.add('hidden');
            }
        });

        window.onload = () => {
            updateModeUI();
            loadProgressFromStorage();
            fetchQuestions();
            setupSwipe();
        };
    </script>
</body>
</html>
