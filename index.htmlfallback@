<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>CA Final Audit – KBC Style Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background: radial-gradient(circle at top center, #1b0a3f 0%, #05010a 100%);
            color: #ffffff;
            min-height: 100vh;
            min-height: 100dvh;
            background-attachment: fixed;
            overflow-x: hidden;
            padding-bottom: 20px;
            overscroll-behavior-y: contain;
            -webkit-overflow-scrolling: touch;
            user-select: none;
            -webkit-user-select: none;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        .option-btn {
            background: linear-gradient(145deg, #182260 0%, #0b0f33 100%);
            border: 2px solid #3b82f6;
            transition: all 0.15s ease-out;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            min-height: 60px;
            border-radius: 16px;
            font-size: 14px;
            padding: 14px 16px;
        }
        .option-btn:active:not(:disabled) {
            transform: scale(0.97);
            transition: transform 0.05s ease-out;
        }
        .option-btn:hover:not(:disabled) {
            background: linear-gradient(145deg, #1e3a8a 0%, #172554 100%);
            border-color: #f59e0b;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.4);
            transform: translateY(-2px);
        }
        .option-selected {
            background: linear-gradient(145deg, #d97706 0%, #92400e 100%) !important;
            border-color: #fef08a !important;
        }
        .option-correct {
            background: linear-gradient(145deg, #166534 0%, #14532d 100%) !important;
            border-color: #4ade80 !important;
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.6);
        }
        .option-wrong {
            background: linear-gradient(145deg, #991b1b 0%, #7f1d1d 100%) !important;
            border-color: #fca5a5 !important;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.6);
        }
        .glow-gold { text-shadow: 0 0 10px #f59e0b, 0 0 20px #f59e0b; }

        /* Palette */
        .palette-btn {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            border: 1.5px solid #475569;
            background: #1e293b;
            color: #cbd5e1;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            touch-action: manipulation;
            flex-shrink: 0;
        }
        .palette-btn:active { transform: scale(0.9); }
        .palette-btn.answered { background: #2563eb; border-color: #60a5fa; color: #fff; }
        .palette-btn.wrong { background: #b91c1c; border-color: #f87171; color: #fff; }
        .palette-btn.marked { background: #d97706; border-color: #fcd34d; color: #fff; }
        .palette-btn.current { border-color: #fff !important; box-shadow: 0 0 0 3px rgba(255,255,255,0.3); transform: scale(1.1); }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            background: #1e1e3f;
            border: 1px solid #f59e0b;
            color: #fef08a;
            padding: 10px 20px;
            border-radius: 40px;
            font-size: 12px;
            font-weight: 600;
            z-index: 200;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s, transform 0.4s;
            white-space: nowrap;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(-8px);
            pointer-events: auto;
        }

        /* Revision list */
        .revision-item {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 10px;
            transition: background 0.2s;
        }
        .revision-item:hover { background: rgba(255,255,255,0.06); }

        /* Social Icons */
        .sf-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            transition: all 0.3s ease;
            background: rgba(0,0,0,0.5);
        }
        .sf-icon.ig { border: 1px solid #e1306c; color: #e1306c; }
        .sf-icon.ig:hover { background: #e1306c; color: #fff; box-shadow: 0 0 15px #e1306c; transform: translateY(-3px); }
        .sf-icon.li { border: 1px solid #0077b5; color: #0077b5; }
        .sf-icon.li:hover { background: #0077b5; color: #fff; box-shadow: 0 0 15px #0077b5; transform: translateY(-3px); }
        .sf-icon.yt { border: 1px solid #ff0000; color: #ff0000; }
        .sf-icon.yt:hover { background: #ff0000; color: #fff; box-shadow: 0 0 15px #ff0000; transform: translateY(-3px); }
        .sf-icon.tg { border: 1px solid #0088cc; color: #0088cc; }
        .sf-icon.tg:hover { background: #0088cc; color: #fff; box-shadow: 0 0 15px #0088cc; transform: translateY(-3px); }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
    </style>
</head>
