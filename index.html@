<!-- ── SCRIPTS ── -->
<script>
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  function playBeep(f=440,t='sine',d=0.15){if(audioCtx.state==='suspended')audioCtx.resume();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.08,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d);}
  function soundCorrect(){playBeep(523,'triangle',0.18);setTimeout(()=>playBeep(659,'triangle',0.18),150);setTimeout(()=>playBeep(784,'triangle',0.35),300);}
  function soundWrong(){playBeep(220,'sawtooth',0.25);setTimeout(()=>playBeep(180,'sawtooth',0.4),200);}
</script>
<script>
  let currentMode = localStorage.getItem('caAuditProMode') || 'study';
  let questionsData = [], currentIdx = 0, isAnswered = false, selectedOption = null, sessionState = [], toastShown = false;

  function updateModeUI(){
    const s=document.getElementById('btn-mode-study'), m=document.getElementById('btn-mode-mcqs');
    const active="nav-pill-btn flex-1 px-3 py-2 rounded-full text-[10px] md:text-xs font-semibold bg-blue-600 text-white transition shadow-sm flex items-center justify-center gap-1";
    const inactive="nav-pill-btn flex-1 px-3 py-2 rounded-full text-[10px] md:text-xs font-semibold text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition flex items-center justify-center gap-1";
    s.className=currentMode==='study'?active:inactive; m.className=currentMode==='mcqs'?active:inactive;
  }
  function switchMode(mode){if(currentMode===mode)return; currentMode=mode; localStorage.setItem('caAuditProMode',mode); updateModeUI(); resetLifelines(); loadProgressFromStorage(); fetchQuestions();}
  function saveProgress(){const key=`caAuditPro_${currentMode}`; localStorage.setItem(key,JSON.stringify({idx:currentIdx,state:sessionState}));}
  function loadProgressFromStorage(){const key=`caAuditPro_${currentMode}`; const raw=localStorage.getItem(key); if(raw){try{const d=JSON.parse(raw); currentIdx=d.idx||0; sessionState=d.state||[];}catch(e){resetProgress();}}else{resetProgress();}}
  function resetProgress(){currentIdx=0; sessionState=[]; toastShown=false;}
  function escapeHtml(v=''){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[c]);}
  function toOptionIndex(value,options){const n=Number(value); if(Number.isInteger(n)&&n>=0&&n<options.length)return n; if(Number.isInteger(n)&&n>=1&&n<=options.length)return n-1; return 0;}

  function normaliseCaseScenarioData(data){
    const records=Array.isArray(data)?data:(data.caseScenarios||data.questions||[]);
    return records.flatMap((rec,ri)=>{
      if(rec.type==='case_scenario'||Array.isArray(rec.questions)){
        const sn=rec.scenarioNumber??rec.id??ri+1;
        return (rec.questions||[]).map((q,qi)=>{const opts=Array.isArray(q.options)?q.options:[]; return {question:q.question||`Question ${qi+1}`,options:opts,correctOption:toOptionIndex(q.correctOption,opts),explanation:q.explanation||'',caseStudy:rec.caseStudy||rec.scenario||'',scenarioNumber:sn,questionNumber:q.questionNumber||`${sn}.${qi+1}`};});
      }
      const opts=Array.isArray(rec.options)?rec.options:[];
      return [{...rec,options:opts,correctOption:toOptionIndex(rec.correctOption,opts)}];
    }).filter(q=>q.options.length>0);
  }

  async function fetchJson(url){const r=await fetch(url); if(!r.ok)throw new Error(`${url}: HTTP ${r.status}`); return r.json();}
  async function fetchQuestions(){
    const caseMode=currentMode==='mcqs';
    const files=caseMode?['./audit_case_scenarios.json']:['./study.json','./mcqs.json'];
    try{
      const payloads=await Promise.all(files.map(fetchJson));
      questionsData=caseMode?normaliseCaseScenarioData(payloads[0]):payloads.flatMap(normaliseCaseScenarioData);
      if(!Array.isArray(questionsData)||questionsData.length===0)throw new Error('No usable questions');
      if(sessionState.length!==questionsData.length) sessionState=questionsData.map((_,i)=>sessionState[i]||{selected:null,isCorrect:null,marked:false});
      if(currentIdx>=questionsData.length)currentIdx=0;
      initGame();
    }catch(e){
      document.getElementById('question-text').innerText=`Unable to load quiz data. Ensure these files are beside this HTML: ${files.join(', ')}.`;
      document.getElementById('options-grid').innerHTML=''; document.getElementById('dots-strip').innerHTML='';
      console.error(e);
    }
  }

  function initGame(){document.getElementById('end-screen').classList.add('hidden'); document.getElementById('end-screen').classList.remove('flex'); document.getElementById('quiz-container').classList.remove('hidden'); document.getElementById('quiz-footer').classList.remove('hidden'); loadQuestion(); maybeShowSubscribeToast();}
  function wrapTables(container){container.querySelectorAll('table').forEach(t=>{if(!t.parentElement.classList.contains('table-wrap')){const w=document.createElement('div'); w.className='table-wrap'; t.parentNode.insertBefore(w,t); w.appendChild(t);}});}

  function loadQuestion(){
    isAnswered=false; selectedOption=null; const q=questionsData[currentIdx];
    const caseStudy=q.caseStudy?`<div class="case-study-box"><div class="mb-2 font-bold uppercase tracking-wider text-blue-600 flex items-center gap-1.5 sticky -top-0.5 text-xs"><i class="fa-solid fa-file-contract"></i> Case Scenario ${escapeHtml(q.scenarioNumber)}</div><div class="whitespace-pre-wrap text-sm">${escapeHtml(q.caseStudy)}</div></div>`:'';
    const qLabel=q.questionNumber||`Q${currentIdx+1}`;
    const qEl=document.getElementById('question-text');
    qEl.innerHTML=`${caseStudy}<div><span class="text-blue-600 font-bold tracking-wider mr-1">${escapeHtml(qLabel)}.</span> ${escapeHtml(q.question)}</div>`;
    wrapTables(qEl);
    document.getElementById('score-counter').innerText=`Q: ${currentIdx+1} / ${questionsData.length}`;
    updateMarkReviewIcon();
    const grid=document.getElementById('options-grid'); grid.innerHTML='';
    const state=sessionState[currentIdx]||{selected:null,isCorrect:null,marked:false};
    q.options.forEach((opt,idx)=>{
      const btn=document.createElement('button'); btn.id=`opt-${idx}`; btn.className="option-btn";
      const letter=String.fromCharCode(65+idx);
      btn.innerHTML=`<span class="opt-letter">${letter}</span> <span class="leading-relaxed text-left">${opt}</span>`;
      if(state.selected!==null){btn.disabled=true; if(idx===state.selected&&!state.isCorrect)btn.classList.add('option-wrong'); if(idx===q.correctOption)btn.classList.add('option-correct'); isAnswered=true;}
      btn.onclick=()=>selectOption(idx); grid.appendChild(btn);
    });
    wrapTables(grid); renderDotsStrip(); document.getElementById('scroll-area').scrollTo({top:0,behavior:'auto'}); saveProgress();
  }

  function renderDotsStrip(){
    const strip=document.getElementById('dots-strip'); strip.innerHTML='';
    questionsData.forEach((_,i)=>{
      const state=sessionState[i]||{selected:null,isCorrect:null,marked:false};
      const dot=document.createElement('button'); dot.className='palette-dot'; dot.textContent=i+1;
      if(i===currentIdx)dot.classList.add('current');
      if(state.selected!==null)dot.classList.add(state.isCorrect?'answered':'wrong');
      if(state.marked){const md=document.createElement('span'); md.className='mark-dot'; dot.appendChild(md);}
      dot.onclick=()=>jumpTo(i); strip.appendChild(dot);
    });
  }

  function selectOption(idx){if(isAnswered)return; playBeep(300,'sine',0.08); const btns=document.getElementById('options-grid').children; for(let b of btns)b.classList.remove('option-selected'); selectedOption=idx; document.getElementById(`opt-${idx}`).classList.add('option-selected'); setTimeout(()=>lockAnswer(idx),500);}
  function lockAnswer(idx){if(isAnswered)return; isAnswered=true; const q=questionsData[currentIdx]; const isCorrect=idx===q.correctOption; const prev=(sessionState[currentIdx]||{}).marked||false; sessionState[currentIdx]={selected:idx,isCorrect,marked:prev}; const s=document.getElementById(`opt-${idx}`),c=document.getElementById(`opt-${q.correctOption}`); s.classList.remove('option-selected'); if(isCorrect){s.classList.add('option-correct'); soundCorrect();}else{s.classList.add('option-wrong'); if(c)c.classList.add('option-correct'); soundWrong();} disableAllOptions(); renderDotsStrip(); saveProgress(); setTimeout(()=>showExplanation(isCorrect),800);}
  function disableAllOptions(){const btns=document.getElementById('options-grid').children; for(let b of btns)b.disabled=true;}
  function showExplanation(isCorrect){const q=questionsData[currentIdx]; const modal=document.getElementById('explanation-modal'); document.getElementById('modal-title').innerHTML=isCorrect?'<i class="fa-solid fa-circle-check text-green-500 text-2xl md:text-3xl"></i> <span class="text-green-600">Awesome!</span>':'<i class="fa-solid fa-circle-xmark text-red-500 text-2xl md:text-3xl"></i> <span class="text-red-600">Incorrect!</span>'; let sub=isCorrect?'You selected the right answer.':`Correct answer:<br><div class="text-slate-700 text-xs md:text-sm text-left bg-slate-50 p-3 rounded-xl border border-slate-200 mt-2 font-medium flex gap-2"><span class="w-5 h-5 flex items-center justify-center shrink-0 bg-green-50 rounded-full border border-green-200 text-[10px] text-green-600">${String.fromCharCode(65+q.correctOption)}</span> <span>${q.options[q.correctOption]}</span></div>`; if(q.explanation)sub+=`<br><div class="text-slate-500 text-xs text-left bg-slate-50 p-3 rounded-xl border border-slate-200 mt-2"><b class="text-slate-700">Explanation:</b> ${q.explanation}</div>`; document.getElementById('modal-subtitle').innerHTML=sub; document.getElementById('modal-continue-btn').innerText=currentIdx===questionsData.length-1?'Finish Quiz':'Next Question'; modal.classList.remove('hidden');}
  function nextQuestion(){document.getElementById('explanation-modal').classList.add('hidden'); if(currentIdx<questionsData.length-1){currentIdx++; loadQuestion(); maybeShowSubscribeToast();}else{finishQuiz();}}
  function prevQuestion(){document.getElementById('explanation-modal').classList.add('hidden'); if(currentIdx>0){currentIdx--; loadQuestion();}}
  function toggleMarkReview(){const s=sessionState[currentIdx]||{selected:null,isCorrect:null,marked:false}; s.marked=!s.marked; sessionState[currentIdx]=s; updateMarkReviewIcon(); renderDotsStrip(); saveProgress();}
  function updateMarkReviewIcon(){const b=document.getElementById('mark-review-btn'); const s=sessionState[currentIdx]||{marked:false}; b.innerHTML=s.marked?'<i class="fa-solid fa-bookmark text-amber-500"></i>':'<i class="fa-regular fa-bookmark text-slate-400"></i>';}
  function togglePalette(){const p=document.getElementById('palette-panel'); if(p.classList.contains('hidden')){renderPalette(); p.classList.remove('hidden');}else{p.classList.add('hidden');}}
  function renderPalette(){const grid=document.getElementById('palette-grid'); grid.innerHTML=''; for(let i=0;i<questionsData.length;i++){const btn=document.createElement('button'); btn.textContent=i+1; btn.className='palette-sheet-btn'; const s=sessionState[i]||{selected:null,isCorrect:null,marked:false}; if(i===currentIdx)btn.classList.add('current'); if(s.selected!==null)btn.classList.add(s.isCorrect?'answered':'wrong'); if(s.marked){const md=document.createElement('span'); md.className='mark-dot'; btn.appendChild(md);} btn.onclick=()=>{jumpTo(i); togglePalette();}; grid.appendChild(btn);}}
  function jumpTo(idx){if(idx>=0&&idx<questionsData.length){currentIdx=idx; loadQuestion();}}
  function openRevision(){const panel=document.getElementById('revision-panel'),list=document.getElementById('revision-list'); list.innerHTML=''; questionsData.forEach((q,i)=>{const s=sessionState[i]||{selected:null,isCorrect:null,marked:false}; const div=document.createElement('div'); div.className='revision-item'; let icon=s.selected!==null?(s.isCorrect?'<i class="fa-solid fa-circle-check text-green-500"></i>':'<i class="fa-solid fa-circle-xmark text-red-500"></i>'):'<i class="fa-regular fa-square text-slate-400"></i>'; const markIcon=s.marked?' <i class="fa-solid fa-star text-amber-500 ml-1"></i>':''; div.innerHTML=`<div class="flex items-start gap-3"><div class="text-lg shrink-0 mt-0.5">${icon}</div><div class="flex-1"><p class="text-sm font-semibold text-slate-800 leading-snug">Q${i+1}: ${q.question.substring(0,100)}...${markIcon}</p>${s.selected!==null?`<p class="text-xs text-slate-500 mt-1.5 bg-slate-50 p-2 rounded border border-slate-200">Your answer: <span class="${s.isCorrect?'text-green-600 font-medium':'text-red-600 font-medium'}">${q.options[s.selected]}</span></p>`:''}<p class="text-xs text-blue-600 mt-1 font-medium">Correct: ${q.options[q.correctOption]}</p></div></div>`; div.onclick=()=>{jumpTo(i); closeRevision();}; list.appendChild(div);}); panel.classList.remove('hidden');}
  function closeRevision(){document.getElementById('revision-panel').classList.add('hidden');}
  document.getElementById('revision-panel').addEventListener('click',e=>{if(e.target.id==='revision-panel')closeRevision();});

  function finishQuiz(){document.getElementById('quiz-container').classList.add('hidden'); const end=document.getElementById('end-screen'); end.classList.remove('hidden'); end.classList.add('flex'); localStorage.setItem(`caAuditPro_${currentMode}`,JSON.stringify({idx:0,state:[]})); resetProgress();}
  function retakeQuiz(){if(confirm('Restart quiz from Question 1?')){resetProgress(); loadProgressFromStorage(); resetLifelines(); initGame();}}
  function resetLifelines(){['life-5050','life-poll','life-expert'].forEach(id=>{const b=document.getElementById(id); b.disabled=false; b.classList.remove('opacity-40','cursor-not-allowed');});}
  function use5050(){if(isAnswered)return; const q=questionsData[currentIdx]; const wrong=q.options.map((_,i)=>i).filter(i=>i!==q.correctOption); wrong.sort(()=>Math.random()-0.5); wrong.slice(0,Math.min(2,wrong.length)).forEach(i=>{const el=document.getElementById(`opt-${i}`); if(el){el.style.opacity='0.25'; el.disabled=true;}}); document.getElementById('life-5050').disabled=true; document.getElementById('life-5050').classList.add('opacity-40','cursor-not-allowed');}
  function useAudiencePoll(){if(isAnswered)return; alert(`📊 Audience Poll: Option ${String.fromCharCode(65+questionsData[currentIdx].correctOption)} leads with huge majority!`); document.getElementById('life-poll').disabled=true; document.getElementById('life-poll').classList.add('opacity-40','cursor-not-allowed');}
  function useExpertAdvice(){if(isAnswered)return; alert(`👨‍🏫 Satyam's Advice: "Based on standards, Option (${String.fromCharCode(65+questionsData[currentIdx].correctOption)}) is the way."`); document.getElementById('life-expert').disabled=true; document.getElementById('life-expert').classList.add('opacity-40','cursor-not-allowed');}
  function maybeShowSubscribeToast(){if(toastShown)return; const attempted=sessionState.filter(s=>s.selected!==null).length; if(attempted>=20&&!localStorage.getItem('caAuditSubToastShown')){const t=document.getElementById('toast'); t.innerHTML=`❤️ Like the app? <a href="https://youtube.com/@observe_with_satyam?si=9BiGcrs2Dhv4HDFa" target="_blank" class="underline text-white">Subscribe to Satyam's YouTube</a> for more!`; t.classList.add('show'); localStorage.setItem('caAuditSubToastShown','1'); toastShown=true; setTimeout(()=>t.classList.remove('show'),5000);}}

  function setupSwipe(){
    const area=document.getElementById('scroll-area'); let sx=0,sy=0,trk=false; const MIN=45;
    area.addEventListener('touchstart',e=>{sx=e.touches[0].clientX; sy=e.touches[0].clientY; trk=true;},{passive:true});
    area.addEventListener('touchmove',e=>{if(!trk)return; if(Math.abs(e.touches[0].clientY-sy)>Math.abs(e.touches[0].clientX-sx))trk=false;},{passive:true});
    area.addEventListener('touchend',e=>{if(!trk)return; const dx=e.changedTouches[0].clientX-sx; if(Math.abs(dx)>MIN){if(dx<0)nextQuestion(); else prevQuestion();} trk=false;},{passive:true});
  }

  window.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight')nextQuestion(); if(e.key==='ArrowLeft')prevQuestion();
    if(e.key==='p'||e.key==='P')togglePalette(); if(e.key==='r'||e.key==='R')openRevision();
    if(e.key==='Escape'){document.getElementById('explanation-modal').classList.add('hidden'); document.getElementById('palette-panel').classList.add('hidden'); document.getElementById('revision-panel').classList.add('hidden');}
  });

  window.onload=()=>{updateModeUI(); loadProgressFromStorage(); fetchQuestions(); setupSwipe();};
</script>
</body>
