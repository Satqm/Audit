<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>CA Final Audit · Mobile‑first Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --primary: #3b82f6;
      --primary-light: #dbeafe;
      --correct: #059669;
      --correct-bg: #d1fae5;
      --wrong: #dc2626;
      --wrong-bg: #fee2e2;
      --marked: #f59e0b;
      --marked-bg: #fef3c7;
      --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-lg: 0 4px 24px rgba(0,0,0,0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    html, body { height: 100%; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
    }

    .poppins { font-family: 'Poppins', sans-serif; }

    .app-shell {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      max-width: 900px;
      margin: 0 auto;
      width: 100%;
      background: var(--bg);
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .case-study-box {
      max-height: 30vh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 16px;
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--text);
    }

    .question-box {
      font-size: 1rem;
      line-height: 1.65;
      color: var(--text);
      padding: 8px 0;
    }

    .option-btn {
      background: var(--surface);
      border: 1.5px solid var(--border);
      transition: all 0.15s ease;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      min-height: 48px;
      border-radius: 12px;
      font-size: 0.9rem;
      padding: 12px 14px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      color: var(--text);
      box-shadow: var(--shadow);
    }
    .option-btn:active:not(:disabled) { transform: scale(0.98); }
    .option-btn:hover:not(:disabled) { border-color: var(--primary); background: var(--primary-light); }
    .option-selected { border-color: var(--marked) !important; background: var(--marked-bg) !important; }
    .option-correct { border-color: var(--correct) !important; background: var(--correct-bg) !important; color: var(--correct) !important; }
    .option-wrong { border-color: var(--wrong) !important; background: var(--wrong-bg) !important; color: var(--wrong) !important; }

    .opt-letter {
      display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 8px;
      background: #f1f5f9; color: var(--text-secondary); font-weight: 700;
      font-size: 0.8rem; flex-shrink: 0; border: 1px solid var(--border);
    }
    .option-correct .opt-letter { background: #d1fae5; color: var(--correct); border-color: var(--correct); }
    .option-wrong .opt-letter { background: #fee2e2; color: var(--wrong); border-color: var(--wrong); }
    .option-selected .opt-letter { background: #fef3c7; color: #92400e; border-color: var(--marked); }

    .table-wrap {
      overflow-x: auto; -webkit-overflow-scrolling: touch;
      border-radius: 10px; border: 1px solid var(--border); margin: 10px 0;
    }
    .table-wrap table { min-width: 480px; border-collapse: collapse; width: 100%; font-size: 0.85rem; }
    .table-wrap th, .table-wrap td { padding: 8px 10px; border: 1px solid var(--border); text-align: left; }
    .table-wrap th { background: #f8fafc; font-weight: 600; color: var(--text-secondary); }

    /* ── Palette dots (inline strip + full sheet) ── */
    .palette-dot {
      width: 44px; height: 44px; min-width: 44px; min-height: 44px;
      border-radius: 10px; font-size: 12px; font-weight: 600;
      border: 1.5px solid var(--border); background: var(--surface);
      color: var(--text-secondary); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      touch-action: manipulation; flex-shrink: 0; position: relative;
      transition: all 0.15s;
    }
    .palette-dot:active { transform: scale(0.92); }
    .palette-dot.answered { background: #dbeafe; border-color: var(--primary); color: var(--primary); }
    .palette-dot.wrong { background: #fee2e2; border-color: var(--wrong); color: var(--wrong); }
    .palette-dot.current { border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); transform: scale(1.05); }
    .palette-dot .mark-dot {
      position: absolute; top: -3px; right: -3px;
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--marked); border: 1.5px solid #d97706;
    }

    .palette-sheet-btn {
      width: 44px; height: 44px; border-radius: 10px; font-size: 13px; font-weight: 600;
      border: 1.5px solid var(--border); background: var(--surface); color: var(--text-secondary);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      touch-action: manipulation; flex-shrink: 0; position: relative; transition: all 0.15s;
    }
    .palette-sheet-btn:active { transform: scale(0.92); }
    .palette-sheet-btn.answered { background: #dbeafe; border-color: var(--primary); color: var(--primary); }
    .palette-sheet-btn.wrong { background: #fee2e2; border-color: var(--wrong); color: var(--wrong); }
    .palette-sheet-btn.current { border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); transform: scale(1.05); }
    .palette-sheet-btn .mark-dot {
      position: absolute; top: -4px; right: -4px;
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--marked); border: 1.5px solid #d97706;
    }

    .nav-pill-btn {
      touch-action: manipulation; -webkit-tap-highlight-color: transparent; min-height: 44px;
    }

    .toast {
      position: fixed; bottom: 120px; left: 50%; transform: translateX(-50%);
      background: var(--text); border: 1px solid var(--border); color: #fff;
      padding: 10px 18px; border-radius: 24px; font-size: 12px; font-weight: 600;
      z-index: 200; opacity: 0; pointer-events: none;
      transition: opacity 0.4s, transform 0.4s; max-width: 90vw; text-align: center;
      box-shadow: var(--shadow-lg);
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(-6px); pointer-events: auto; }

    .revision-item {
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      padding: 14px 16px; margin-bottom: 10px; cursor: pointer;
      transition: background 0.2s; touch-action: manipulation;
    }
    .revision-item:active { background: #f1f5f9; }

    .sf-icon {
      width: 36px; height: 36px; min-width: 36px; min-height: 36px;
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 0.95rem; transition: all 0.25s ease; background: #f1f5f9;
      touch-action: manipulation; color: var(--text-secondary); text-decoration: none;
    }
    .sf-icon.ig:hover, .sf-icon.ig:active { background: #e1306c; color: #fff; }
    .sf-icon.li:hover, .sf-icon.li:active { background: #0077b5; color: #fff; }
    .sf-icon.yt:hover, .sf-icon.yt:active { background: #ff0000; color: #fff; }
    .sf-icon.tg:hover, .sf-icon.tg:active { background: #0088cc; color: #fff; }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  </style>
</head>
